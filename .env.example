# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server & Database Configuration
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/jr_printing_db
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:3000

# Email Service Configuration (SMTP / Nodemailer for OTP & Password Reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="JR PRINTING WORKS" <no-reply@jrprinting.in>

# Razorpay Payment Gateway Configuration (India)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend API URL
VITE_API_URL="/api"
