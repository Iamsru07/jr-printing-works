# JR PRINTING WORKS - Environment Variables Configuration

# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jr_printing_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Email Service Configuration (SMTP / Nodemailer for OTP & Password Reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM="JR PRINTING WORKS" <no-reply@jrprinting.in>

# Razorpay Payment Gateway Configuration (India)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Frontend API URL (if frontend is hosted separately)
VITE_API_URL=http://localhost:5000/api
